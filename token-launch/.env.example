# ============================================
# TOKEN CONFIGURATION (Shared)
# ============================================
TOKEN_NAME=Tokencoin
TOKEN_SYMBOL=TOKEN
TOKEN_DECIMALS=18
TOKEN_INITIAL_SUPPLY=10000000000

# ============================================
# VESTING CONFIGURATION (Shared)
# ============================================
VESTING_DURATION_DAYS=365
VESTING_CLIFF_DAYS=30

# ============================================
# TESTNET CONFIGURATION (.env.bscTestnet)
# ============================================
# BSC Testnet RPC
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Testnet Private Key (NEVER COMMIT MAINNET KEY!)
PRIVATE_KEY=your_testnet_private_key_here

# BSCScan API Key
BSCSCAN_API_KEY=your_bscscan_api_key

# ============================================
# MAINNET CONFIGURATION (.env.bscMainnet)
# ============================================
# BSC Mainnet RPC
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org/

# Multi-Sig Configuration (Gnosis Safe)
MULTISIG_OWNER1=0x...
MULTISIG_OWNER2=0x...
OWNER_THRESHOLD=2

# Mainnet Private Key (NEVER COMMIT!)
PRIVATE_KEY=your_mainnet_private_key_here

# ============================================
# CONTRACT SETTINGS (Environment Specific)
# ============================================
# Testnet - More relaxed for testing
TIMELOCK_DELAY=7200      # 2 hours
MAX_EMERGENCY_WITHDRAW_BPS=1000  # 10%

# Mainnet - More strict for production
# TIMELOCK_DELAY=7200     # 2 hours
# MAX_EMERGENCY_WITHDRAW_BPS=500  # 5%
